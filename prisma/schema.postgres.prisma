// Variante del esquema para producción en Vercel + Neon (PostgreSQL).
// El script `vercel-build` la usa automáticamente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pedido {
  id              String    @id @default(cuid())
  codigo          String    @unique
  estado          String    @default("Pendiente")
  clienteNombre   String
  clienteTelefono String
  clienteEmail    String?
  direccion       String
  metodoPago      String
  producto        String    @default("")
  tipoPiel        String?
  aceite          String?
  aroma           String?
  tamanoId        String    @default("")
  tamanoEtiqueta  String    @default("")
  cantidad        Int       @default(1)
  precioUnit      Int       @default(0)
  total           Int       @default(0)
  notasAdmin      String    @default("")
  creadoEn        DateTime  @default(now())
  realizadoEn     DateTime?
  entregadoEn     DateTime?
  canceladoEn     DateTime?

  @@map("pedidos")
}

model CostoTamano {
  id            String   @id @default(cuid())
  tamanoId      String   @unique
  etiqueta      String
  costoUnitario Int
  actualizadoEn DateTime @updatedAt

  @@map("costos_tamano")
}

model MateriaPrima {
  id             String   @id @default(cuid())
  nombre         String
  categoria      String
  cantidadCompra Float
  unidad         String
  costoTotal     Int
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  @@map("materias_primas")
}

model AdminUser {
  id            String   @id @default(cuid())
  usuario       String   @unique
  passwordHash  String
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("admin_users")
}

model Ajuste {
  clave         String   @id
  valor         String
  actualizadoEn DateTime @updatedAt

  @@map("ajustes")
}
